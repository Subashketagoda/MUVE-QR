# ==============================================================================
# MUVE QR - Environment Variables Configuration
# ==============================================================================
# The application functions seamlessly in Demo Mode with fallback sample data.
# To connect to live Supabase backend, supply your project credentials below:

# Supabase Public URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Server-only / Admin API)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
